[Unit]
Description=Nullworx Next.js (%i)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nullworx
Group=nullworx
WorkingDirectory=/srv/nullworx/%i
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/nullworx/%i.env
ExecStart=@NODE@ /srv/nullworx/%i/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port ${PORT} --keepAliveTimeout 180000
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/nullworx/%i/.next/cache
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nullworx-%i

[Install]
WantedBy=multi-user.target
