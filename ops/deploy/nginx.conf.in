# Alternative ONLY if inventory finds an existing nginx + functioning ACME setup.
# Substitute audited port and real certificate paths; do not load placeholders.
# Reuse the existing challenge handler/renewal mechanism. Never replace shared config.
server {
    listen 80;
    server_name nullworx.space www.nullworx.space;
    # Preserve the site's ACME HTTP-01 handler before adding this redirect location.
    location / { return 308 https://nullworx.space$request_uri; }
}
server {
    listen 443 ssl;
    server_name www.nullworx.space;
    ssl_certificate @FULLCHAIN@;
    ssl_certificate_key @PRIVKEY@;
    add_header Strict-Transport-Security "max-age=31536000" always;
    return 308 https://nullworx.space$request_uri;
}
server {
    listen 443 ssl;
    server_name nullworx.space;
    ssl_certificate @FULLCHAIN@;
    ssl_certificate_key @PRIVKEY@;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:@PRODUCTION_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
