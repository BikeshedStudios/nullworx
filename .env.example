# Canonical origin for production builds. Defaults to https://nullworx.space when unset.
# Leave this unset for the launch build; the target host is the verified default.
# NEXT_PUBLIC_SITE_URL=https://nullworx.space
# Local-only preview (canonical and sitemap then point at localhost, not production):
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3350
# Build-time media path, only after source-specific hosting rights are recorded.
# Default is /media/local. See MEDIA_PROVISIONING.md before configuring a CDN.
# NEXT_PUBLIC_UI_FORGE_MEDIA_BASE=/media/production/loop30-v2-807bb27e
# ASCII-only featured fish receipt JSON; unset until source licence/linkage and
# host staging are verified. See docs/releases/ASCII_QUALITY_02.md. No default.
# NEXT_PUBLIC_ASCII_FEATURED_MEDIA=

# Optional support URL; defaults to the verified Bikeshed Studios page.
# NEXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/bikeshedstudios
# Set ONLY once a real published creator pack and checkout have been checked.
# NEXT_PUBLIC_GUMROAD_PRODUCT_URL=https://bikeshedstudios.gumroad.com/l/verified-product
# NEXT_PUBLIC_GUMROAD_PRODUCT_PUBLISHED=1  # Only after verifying publication + purchase/download

# Server-only newsletter settings, manually enabled only after production edge limit,
# real double-opt-in/unsubscribe test and private data-request contact are verified.
# NULLWORX_DROPS_ENABLED=1
# DROPS_PRIVACY_CONTACT_EMAIL=owner-verified-address@example.com
# The Drops CTA is hidden unless this flag, the contact and all Brevo values are valid.
# BREVO_API_KEY: provide securely in server-side secrets; never commit its value.
# BREVO_LIST_ID=123
# BREVO_DOI_TEMPLATE_ID=456
